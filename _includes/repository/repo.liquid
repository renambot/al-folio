{% comment %}
  Renders a GitHub repository card.

  The card is complete without any third-party service: the repository name,
  the GitHub icon and the link are baked in at build time. Live metadata
  (description, language, stars, forks) is filled in by assets/js/repo_cards.js
  when api.github.com is reachable, and simply stays hidden when it is not.
{% endcomment %}

{% assign repo_url = include.repository | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}

{% if site.data.repositories.github_users contains repo_owner %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2 text-center">
  <a
    class="repo-card"
    href="https://github.com/{{ include.repository }}"
    data-repo="{{ include.repository }}"
    title="{{ include.repository }} on GitHub"
  >
    <div class="repo-card-header">
      <svg class="repo-card-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"
        ></path>
      </svg>
      <span class="repo-card-title">
        {% if show_owner -%}
          <span class="repo-card-owner">{{ repo_owner }}/</span>
        {%- endif -%}
        {{- repo_name }}
      </span>
    </div>

    <p class="repo-card-description" data-repo-description></p>

    <div class="repo-card-meta">
      <span class="repo-card-stat" data-repo-language hidden>
        <span class="repo-card-dot" aria-hidden="true"></span>
        <span></span>
      </span>
      <span class="repo-card-stat" data-repo-stars hidden title="Stars">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
          ></path>
        </svg>
        <span></span>
      </span>
      <span class="repo-card-stat" data-repo-forks hidden title="Forks">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path
            fill="currentColor"
            d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"
          ></path>
        </svg>
        <span></span>
      </span>
    </div>
  </a>
</div>
