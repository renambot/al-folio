<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 15%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td style="width: 275px; vertical-align: top;">
                <div style="width: 250px; height:133px;overflow: hidden;">
                  <a class="news-title" href="{{ item.url | relative_url }}">
      {% if item.image %}
                    <img src="{{ item.image | relative_url }}" alt="{{ item.title }}" style="width: 100%; height: 100%; object-fit: cover;" />
      {% else %}
                    <img src="{{ 'assets/img/logo-480.webp' | relative_url }}" alt="{{  item.title }}" style="width: 100%; height: 100%; object-fit: cover;" />
      {% endif %}
                  </a>
              </div>
            </td>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}"> {{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
